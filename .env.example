# === Application ===
APP_BASE_URL=https://standup-jira.example.com
LOG_LEVEL=INFO
ENVIRONMENT=development

# === Slack ===
SLACK_BOT_TOKEN=xoxb-xxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxx
# Comma-separated channel IDs. Only messages from these channels are processed.
SLACK_STANDUP_CHANNELS=C0123ABCDEF,C0456GHIJKL

# Shared bearer token for the /standup/ingest webhook used by the slash-command
# edge function (Deno). The same value must be set as STANDUP_INGEST_TOKEN in
# the edge function environment.
STANDUP_INGEST_TOKEN=

# === Atlassian ===
ATLASSIAN_BASE_URL=https://catchup.atlassian.net
ATLASSIAN_EMAIL=admin@catchup.ai
ATLASSIAN_API_TOKEN=ATATTxxxxxxxx
# Team custom field ID. Find via /rest/api/3/field on initial setup.
ATLASSIAN_TEAM_FIELD_ID=customfield_10001

# === Team → Project mapping ===
# JSON object. Keys are Atlassian Team ARIs, values are Jira project keys.
TEAM_PROJECT_MAP={"ari:cloud:identity::team/abc-123": "CATCHUP"}

# === 작업 구분 ===
# Comma-separated labels for the modal's 작업 구분 dropdown. Free-form; Korean OK.
# Used in the summary template; the Jira issue type is a separate dropdown.
TASK_TYPES=기능,버그,개선,리팩토링,기술부채,문서,조사,데브옵스

# === Gemini ===
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-2.0-flash-exp

# === Database ===
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/standup_jira

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=3600

# === Feature flags ===
ENABLE_LLM_EXTRACTION=true
ENABLE_AUTO_PUBLISH=false
DRY_RUN=true
